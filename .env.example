# LLM provider
# DeepSeek Reasoner via OpenAI-compatible API:
DEEPSEEK_API_KEY=

# Qwen via DashScope OpenAI-compatible API:
DASHSCOPE_API_KEY=

# Optional broader web search providers:
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Optional GitHub API token for GitHub Search API fallback:
GITHUB_TOKEN=

# mini-swe-agent local config, defaults to project-local .mswea in scripts:
MSWEA_GLOBAL_CONFIG_DIR=.mswea
MSWEA_SILENT_STARTUP=1
